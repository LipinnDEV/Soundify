# Copie este arquivo para .env e ajuste os valores:   cp .env.example .env
# O arquivo .env contém segredos e NÃO deve ser versionado (já está no .gitignore).
# Não use aspas, "$" nem "#" nos valores.

# ---- Banco de dados (MySQL 8) ----
MYSQL_DATABASE=soundify
MYSQL_USER=soundify
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-a-senha-do-root
MYSQL_PORT=3306

# ---- Backend (Spring Boot) ----
# Segredo que assina os tokens JWT: mínimo de 32 caracteres. Sugestão para gerar um:   openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-com-32-ou-mais-caracteres
# Validade do token de acesso, em minutos
JWT_EXPIRATION_MINUTES=120
# Origens do frontend autorizadas a chamar a API (CORS), separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
BACKEND_PORT=8080

# ---- Frontend ----
FRONTEND_PORT=3000

# ---- Somente para rodar o backend FORA do Docker (mvn spring-boot:run) ----
# O padrão já é localhost:3306; descomente se o seu MySQL estiver em outro endereço.
# DB_HOST=localhost
# DB_PORT=3306
